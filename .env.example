# Demo mode: sign in with sample data, no database needed. Never enable on a production deployment.
DEMO_MODE=true

# ElevenLabs post-call webhook secret (Agents > Settings > Webhooks). Required for /api/webhooks/elevenlabs.
ELEVENLABS_WEBHOOK_SECRET=

# Postgres (Supabase > Project settings > Database > connection string, pooled, service role).
# Without it the app runs on the in-memory demo store. Apply supabase/migrations/0001_init.sql first.
DATABASE_URL=

# Supabase Auth (email + password sign-in)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) from Supabase > Connect. The older NEXT_PUBLIC_SUPABASE_ANON_KEY name also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared secret the ElevenLabs agent sends to /api/agent-tools/* (see docs/agent-tools.md)
AGENT_TOOLS_SECRET=

# Google service account key (one line of JSON) for reading and writing clinic calendars
GOOGLE_SERVICE_ACCOUNT_JSON=

# Needed to create and manage users from the admin portal (Supabase > Settings > API Keys, secret key). Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this app (e.g. https://www.callsdash.com). ElevenLabs calls back to it.
NEXT_PUBLIC_SITE_URL=

# ElevenLabs API key: lets the admin portal create and update each client's agent, send WhatsApp messages, transcribe voice notes.
ELEVENLABS_API_KEY=
# Optional overrides: JSON list of voices shown in the voice picker, and the agent's LLM name.
ELEVENLABS_VOICES=
ELEVENLABS_LLM=
# Secret the ElevenLabs conversation-start webhook sends (falls back to AGENT_TOOLS_SECRET when empty)
ELEVENLABS_INIT_SECRET=

# Instagram DMs (Meta developer app): app secret verifies incoming messages, verify token is any string you choose and also enter in Meta.
META_APP_SECRET=
META_VERIFY_TOKEN=
# Optional: Graph API base used to send Instagram replies
META_GRAPH_BASE=
