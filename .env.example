# Demo mode: sign in with sample data, no database needed. Never enable on a production deployment.
DEMO_MODE=true

# ElevenLabs post-call webhook secret (Agents > Settings > Webhooks). Required for /api/webhooks/elevenlabs.
ELEVENLABS_WEBHOOK_SECRET=

# Supabase (used once the Supabase data adapter replaces the demo store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
