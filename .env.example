# Demo mode: sign in with sample data, no database needed. Never enable on a production deployment.
DEMO_MODE=true

# ElevenLabs post-call webhook secret (Agents > Settings > Webhooks). Required for /api/webhooks/elevenlabs.
ELEVENLABS_WEBHOOK_SECRET=

# Postgres (Supabase > Project settings > Database > connection string, pooled, service role).
# Without it the app runs on the in-memory demo store. Apply supabase/migrations/0001_init.sql first.
DATABASE_URL=

# Supabase Auth (email + password sign-in)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) from Supabase > Connect. The older NEXT_PUBLIC_SUPABASE_ANON_KEY name also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the ElevenLabs agent sends to /api/agent-tools/* (see docs/agent-tools.md)
AGENT_TOOLS_SECRET=

# Google service account key (one line of JSON) for reading and writing clinic calendars
GOOGLE_SERVICE_ACCOUNT_JSON=
